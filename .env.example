# Set this in production. Leave empty only when using an explicit demo mode.
WORKBENCH_AUTH_TOKEN=replace-with-a-long-random-token

# Runtime mode: auto selects sidecar when DSH_ENDPOINT exists, otherwise native when DSH_HARNESS_HOME exists.
# Use demo only for a deterministic product walkthrough.
DSH_RUNTIME_MODE=auto

# Native DeepSeek Harness configuration. Install: pip install "dsh-workbench[harness]"
DSH_HARNESS_HOME=
DSH_HARNESS_PROFILE=workbench-readonly
DSH_HARNESS_WORKSPACE=
DSH_HARNESS_PATCHES=
DSH_PROVIDER=
DSH_MODEL=
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=

# Optional DSH Harness sidecar endpoint. Auto mode prefers it when set.
DSH_ENDPOINT=
DSH_CALLBACK_URL=

# Optional HMAC secret for DSH callback verification.
DSH_CALLBACK_SECRET=
DSH_CALLBACK_MAX_SKEW=300

# json keeps a readable local fixture; sqlite is recommended for Compose.
WORKBENCH_STORAGE=sqlite

# Optional JWT/OIDC mode. Set JWT secret to validate HS256 access tokens.
WORKBENCH_JWT_SECRET=
WORKBENCH_OIDC_ISSUER=
WORKBENCH_MAX_CONCURRENCY=4

# Optional OpenAI-compatible embedding/rerank providers.
WORKBENCH_EMBEDDING_ENDPOINT=
WORKBENCH_EMBEDDING_API_KEY=
WORKBENCH_EMBEDDING_MODEL=
WORKBENCH_RERANK_ENDPOINT=
WORKBENCH_RERANK_API_KEY=
WORKBENCH_RERANK_MODEL=
